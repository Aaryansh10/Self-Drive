<root BTCPP_format="4" main_tree_to_execute="Main">
    <BehaviorTree ID="Main">
        <ReactiveSequence>
            <DecideAction decision="{decision}" obstacle_id="{obstacle_id}" distance="{stop_distance}"/>
            <ReactiveFallback>
                <!-- Pedestrian/emergency stop can preempt a latched intersection. -->
                <ReactiveSequence>
                    <ScriptCondition code="decision == 'stop'"/>
                    <DisableLaneFollowing/>
                    <KeepRunningUntilFailure>
                        <ForceSuccess><StopRobot distance="{stop_distance}"/></ForceSuccess>
                    </KeepRunningUntilFailure>
                </ReactiveSequence>
                <Sequence>
                    <ScriptCondition code="decision == 'intersection'"/>
                    <BeginIntersection needs_stop="{needs_stop}"/>
                    <DisableLaneFollowing/>
                    <RetryOnNextTick>
                        <Sequence>
                            <Fallback>
                                <ScriptCondition code="needs_stop == false"/>
                                <Sequence>
                                    <StopRobot distance="{stop_distance}"/>
                                    <MarkIntersectionStopped needs_stop="{needs_stop}"/>
                                </Sequence>
                            </Fallback>
                            <Intersection/>
                        </Sequence>
                    </RetryOnNextTick>
                </Sequence>
                <Parallel success_count="-1" failure_count="1">
                    <LaneFollowing/>
                    <KeepRunningUntilFailure>
                        <ForceSuccess>
                            <Sequence>
                                <ScriptCondition code="decision == 'change'"/>
                                <LaneChange obstacle_id="{obstacle_id}"/>
                            </Sequence>
                        </ForceSuccess>
                    </KeepRunningUntilFailure>
                </Parallel>
            </ReactiveFallback>
        </ReactiveSequence>
    </BehaviorTree>
</root>