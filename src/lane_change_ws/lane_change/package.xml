<?xml version="1.0"?>
<package format="3">
  <name>lane_change</name>
  <version>0.1.0</version>
  <description>Lane change action server (rclcpp)</description>
  <maintainer email="you@example.com">Khushi</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <!-- optional: nav2_msgs (enables the /speed_limit output when installed) -->
  <depend>lane_change_interfaces</depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
