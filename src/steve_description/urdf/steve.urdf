<?xml version="1.0" ?>
<robot name="steve" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="link_base">
        <pose>0 0 0.606 0 0 0</pose>
        <inertial>
            <mass value="5"/>
            <origin xyz="0 0 0.606" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_base_visual">
            <geometry>
                <box size="0.914 0.854 0.334"/>
            </geometry>
            <origin xyz="0 0 0.606" rpy="0 0 0"/>
        </visual>
        <collision name="link_base_collision">
            <geometry>
                <box size="0.914 0.854 0.334"/>
            </geometry>
            <origin xyz="0 0 0.606" rpy="0 0 0"/>
        </collision>
    </link>
    <link name="link_wheel_holder_3">
        <pose>0 0 -0.0925 0 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_holder_3_visual">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </visual>
        <collision name="llink_wheel_holder_3_collision">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_link_base_wheel_holder_3" type="revolute">
        <origin rpy="0 0 0" xyz="0.457 0.3345 0.439"/>
        <axis rpy="0 0 0" xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
        <dynamics damping="10.0" friction="0.5"/>
        <child link="link_wheel_holder_3"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_wheel_holder_4">
        <pose>0 0 -0.0925 0 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_holder_4_visual">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </visual>
        <collision name="llink_wheel_holder_4_collision">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_link_base_wheel_holder_4" type="revolute">
        <origin rpy="0 0 0" xyz="0.457 -0.3345 0.439"/>
        <axis rpy="0 0 0" xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
        <dynamics damping="10.0" friction="0.5"/>
        <child link="link_wheel_holder_4"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_wheel_holder_5">
        <pose>0 0 -0.0925 0 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_holder_5_visual">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </visual>
        <collision name="llink_wheel_holder_5_collision">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_link_base_wheel_holder_5" type="revolute">
        <origin rpy="0 0 0" xyz="-0.457 0.3345 0.439"/>
        <axis rpy="0 0 0" xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
        <dynamics damping="10.0" friction="0.5"/>
        <child link="link_wheel_holder_5"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_wheel_holder_6">
        <pose>0 0 -0.0925 0 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_holder_6_visual">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </visual>
        <collision name="llink_wheel_holder_6_collision">
            <geometry>
                <box size="0.185 0.185 0.185"/>
            </geometry>
            <origin xyz="0 0 -0.0925" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_link_base_wheel_holder_6" type="revolute">
        <origin rpy="0 0 0" xyz="-0.457 -0.3345 0.439"/>
        <axis rpy="0 0 0" xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
        <dynamics damping="10.0" friction="0.5"/>
        <child link="link_wheel_holder_6"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_wheel_3">
        <pose>0 0 0 1.57 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_3_visual">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </visual>
        <collision name="link_wheel_3_collision">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_wheel_holder_3_link_wheel_3" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 -0.312"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
        <child link="link_wheel_3"/>
        <parent link="link_wheel_holder_3"/>
    </joint>
    <link name="link_wheel_4">
        <pose>0 0 0 1.57 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_4_visual">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </visual>
        <collision name="link_wheel_4_collision">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_wheel_holder_4_link_wheel_4" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 -0.312"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
        <child link="link_wheel_4"/>
        <parent link="link_wheel_holder_4"/>
    </joint>
    <link name="link_wheel_5">
        <pose>0 0 0 1.57 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_5_visual">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </visual>
        <collision name="link_wheel_5_collision">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_wheel_holder_5_link_wheel_5" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 -0.312"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
        <child link="link_wheel_5"/>
        <parent link="link_wheel_holder_5"/>
    </joint>
    <link name="link_wheel_6">
        <pose>0 0 0 1.57 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_6_visual">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </visual>
        <collision name="link_wheel_6_collision">
            <geometry>
                <cylinder length="0.1" radius="0.127"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_wheel_holder_6_link_wheel_6" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 -0.312"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
        <child link="link_wheel_6"/>
        <parent link="link_wheel_holder_6"/>
    </joint>
    <!-- Plugins -->
       <!-- <gazebo>
        <plugin filename="libgazebo_ros_diff_drive.so" name="gazebo_base_controller">
            <odometry_frame>odom</odometry_frame>
            <commandTopic>cmd_vel</commandTopic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <update_rate>15.0</update_rate>
            <left_joint>joint_link_wheel_holder_3_link_wheel_3</left_joint>
            <right_joint>joint_link_wheel_holder_4_link_wheel_4</right_joint>
            <wheel_separation>0.606</wheel_separation>
            <wheel_diameter>0.254</wheel_diameter>
            <max_wheel_acceleration>0.7</max_wheel_acceleration>
