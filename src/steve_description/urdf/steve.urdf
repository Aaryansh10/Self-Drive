        </plugin>
    </gazebo>
       <gazebo>
        <plugin filename="libgazebo_ros_diff_drive.so" name="gazebo_base_controller1">
            <odometry_frame>odom</odometry_frame>
            <commandTopic>cmd_vel</commandTopic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <update_rate>15.0</update_rate>
            <left_joint>joint_link_wheel_holder_5_link_wheel_5</left_joint>
            <right_joint>joint_link_wheel_holder_6_link_wheel_6</right_joint>
            <wheel_separation>0.606</wheel_separation>
            <wheel_diameter>0.254</wheel_diameter>
            <max_wheel_acceleration>0.7</max_wheel_acceleration>
            <robotBaseFrame>link_base</robotBaseFrame>
        </plugin>
    </gazebo> -->
    <gazebo>
        <plugin name="ackermann_drive" filename="libackerman_drive_plugin.so">
            <updateRate>20</updateRate>
            <commandTopic>cmd_vel</commandTopic>
            <odometryTopic>odom</odometryTopic>
            <odometryFrame>odom</odometryFrame>
            <robotBaseFrame>link_base</robotBaseFrame>
            <publish_odom_tf>false</publish_odom_tf>
            <!-- Robot Dim -->
            <wheelRadius>0.127</wheelRadius>
            <wheelSeperation>0.914</wheelSeperation>
            <wheelBase>0.854</wheelBase>
            <!-- Wheel Joints -->
            <front_left_wheel_joint>joint_link_wheel_holder_3_link_wheel_3</front_left_wheel_joint>
            <front_right_wheel_joint>joint_link_wheel_holder_4_link_wheel_4</front_right_wheel_joint>
            <back_left_wheel_joint>joint_link_wheel_holder_5_link_wheel_5</back_left_wheel_joint>
            <back_right_wheel_joint>joint_link_wheel_holder_6_link_wheel_6</back_right_wheel_joint>
            <!-- Stepper Joints -->
            <front_left_stepper_joint>joint_link_link_base_wheel_holder_3</front_left_stepper_joint>
            <front_right_stepper_joint>joint_link_link_base_wheel_holder_4</front_right_stepper_joint>
            <back_left_stepper_joint>joint_link_link_base_wheel_holder_5</back_left_stepper_joint>
            <back_right_stepper_joint>joint_link_link_base_wheel_holder_6</back_right_stepper_joint>
        </plugin>
    </gazebo>
    <!-- Colors -->
    <gazebo reference="link_base">
        <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link_wheel_3">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="link_wheel_4">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="link_wheel_5">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="link_wheel_6">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="link_wheel_holder_3">
        <material>Gazebo/Green</material>
    </gazebo>
    <gazebo reference="link_wheel_holder_4">
        <material>Gazebo/Green</material>
    </gazebo>
    <gazebo reference="link_wheel_holder_5">
        <material>Gazebo/Green</material>
    </gazebo>
    <gazebo reference="link_wheel_holder_6">
        <material>Gazebo/Green</material>
    </gazebo>
    <!-- Camera Construction-->
    <link name="link_camera_support_left">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass value="0.3"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_camera_support_left_visual">
            <geometry>
                <box size="0.03 0.03 0.768"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision name="link_camera_support_left_collision">
            <geometry>
                <box size="0.03 0.03 0.768"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_base_link_camera_support_left" type="fixed">
        <origin rpy="0 0 0" xyz="0 0.1 1.157"/>
        <child link="link_camera_support_left"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_camera_support_right">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass value="0.3"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_camera_support_right_visual">
            <geometry>
                <box size="0.03 0.03 0.768"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision name="link_camera_support_right_collision">
            <geometry>
                <box size="0.03 0.03 0.768"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_base_link_camera_support_right" type="fixed">
        <origin rpy="0 0 0" xyz="0 -0.1 1.157"/>
        <child link="link_camera_support_right"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_camera_support">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass value="0.3"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_camera_support_visual">
            <geometry>
                <box size="0.03 0.23 0.03"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision name="link_camera_support_collision">
            <geometry>
                <box size="0.03 0.23 0.03"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_camera_support_right_camera_support" type="fixed">
        <origin rpy="0 0 0" xyz="0 0.1 0.384"/>
        <child link="link_camera_support"/>
        <parent link="link_camera_support_right"/>
    </joint>
    <link name="link_camera_zed2i">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass value="0.3"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_camera_zed2i_visual">
            <geometry>
                <box size="0.04 0.17 0.03"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision name="link_camera_zed2i_collision">
            <geometry>
                <box size="0.04 0.17 0.03"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_camera_support_link_camera_zed2i" type="fixed">
        <origin rpy="0 0.4 0" xyz="0.02 0 0.065"/>
        <child link="link_camera_zed2i"/>
        <parent link="link_camera_support"/>
    </joint>

    <!-- Camera Plugin -->
    <gazebo reference="link_camera_zed2i">
        <sensor type="camera" name="monocamera">
            <always_on>1</always_on>
            <update_rate>25</update_rate>
            <visualize>false</visualize>
            <camera>
                <horizontal_fov>1.9</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>360</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.5</near>
                    <far>20</far>
                </clip>
                <noise>
                    <type>none</type>
                </noise>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>zed_node</namespace>
                        <remapping>image_raw:=stereocamera/image_raw</remapping>
                        <remapping>camera_info:=stereocamera/camera_info</remapping>
                    </ros>
                    <camera_name>monocamera</camera_name>
                    <frame_name>link_camera_zed2i</frame_name>
            </plugin>
        </sensor>
  </gazebo>

    <gazebo reference="link_camera_support_left">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="link_camera_support_right">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="link_camera_support">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="link_camera_zed2i">
        <material>Gazebo/Indigo</material>
    </gazebo>
    <!-- Lidar -->
    <link name="link_lidar">
        <visual name="link_lidar_visual">
            <geometry>
                <cylinder radius="0.045" length="0.1"/>
            </geometry>
        </visual>
    </link>
    <joint name="joint_link_base_link_lidar" type="fixed">
        <!-- <origin rpy="0 0 0" xyz="0.255 0 0.823"/> -->
        <origin rpy="0 0 0" xyz="0.255 0 0.88"/>
        <child link="link_lidar"/>
        <parent link="link_base"/>
    </joint>
    <gazebo reference="link_lidar">
        <material>Gazebo/Black</material>
    </gazebo>
    <!-- Lidar Sensor Plugin-->
    <gazebo reference="link_lidar">
      <sensor type="gpu_ray" name="laser">
        <always_on>true</always_on>
        <update_rate>25</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>512</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.25</min_angle>
              <max_angle>0.05</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.055</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>none</type>
          </noise>
        </ray>
        <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>link_lidar</frame_name>
          </plugin>
      </sensor>
    </gazebo>
  <!-- IMU -->
  <joint name="link_imu_joint" type="fixed">
        <parent link="link_camera_support"/>
        <child link="link_imu"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="link_imu" />
  <gazebo reference="link_imu">
        <sensor name="imu_sensor" type="imu">
            <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=imu</remapping>
                </ros>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
            <always_on>true</always_on>
            <update_rate>40</update_rate>
        </sensor>
    </gazebo>
    <gazebo reference="link_base">
    <sensor name="gps_sensor" type="gps">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
            <ros>
                <remapping>~/out:=gps/fix</remapping>
            </ros>
            <frame_name>link_base</frame_name>
        </plugin>
        <gps>
            <position_sensing>
                <horizontal>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </horizontal>
                <vertical>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </vertical>
            </position_sensing>
        </gps>
    </sensor>
  </gazebo>
  <gazebo>
  <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <ros>
      <remapping>~/out:=joint_states</remapping>
    </ros>
    <update_rate>30</update_rate>
    <joint_name>joint_link_link_base_wheel_holder_3</joint_name>
    <joint_name>joint_link_link_base_wheel_holder_4</joint_name>
    <joint_name>joint_link_link_base_wheel_holder_5</joint_name>
    <joint_name>joint_link_link_base_wheel_holder_6</joint_name>
    
    <joint_name>joint_link_wheel_holder_3_link_wheel_3</joint_name>
    <joint_name>joint_link_wheel_holder_4_link_wheel_4</joint_name>
    <joint_name>joint_link_wheel_holder_5_link_wheel_5</joint_name>
    <joint_name>joint_link_wheel_holder_6_link_wheel_6</joint_name>
  </plugin>
</gazebo>
